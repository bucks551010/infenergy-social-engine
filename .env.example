# Existing platform credentials
META_PAGE_ID=REPLACE_ME
META_IG_USER_ID=REPLACE_ME
META_PAGE_ACCESS_TOKEN=REPLACE_ME
LINKEDIN_ACCESS_TOKEN=REPLACE_ME

# Runtime safety and immutable deployment provenance
APP_ENV=production
CONTENT_DISPATCH_ENABLED=false
CONTENT_PREGENERATION_ENABLED=true
CONTENT_PREPARATION_LEAD_TIME_MINUTES=1080
OUTBOX_MAX_ATTEMPTS=4
GEMINI_IMAGE_REPAIR_ATTEMPTS=0
GEMINI_DAILY_CALL_LIMIT=8
GEMINI_DAILY_IMAGE_LIMIT=2
BUILD_GIT_SHA=SET_DURING_BUILD
EXPECTED_GIT_SHA=SET_DURING_DEPLOYMENT
BUILD_TIMESTAMP=SET_DURING_BUILD

# YouTube Data API v3. Keep disabled until OAuth and channel ownership are verified.
YOUTUBE_PUBLISHING_ENABLED=false
YOUTUBE_CLIENT_ID=REPLACE_ME
YOUTUBE_CLIENT_SECRET=REPLACE_ME
YOUTUBE_REFRESH_TOKEN=REPLACE_ME
YOUTUBE_REDIRECT_URI=https://infenergy-intelligence-os.up.railway.app/oauth/youtube/callback
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_CATEGORY_ID=22
YOUTUBE_DEFAULT_TAGS=Infenergy,Micro Mission
YOUTUBE_MADE_FOR_KIDS=false

# TikTok Content Posting API. Keep disabled until app review and account authorization are complete.
TIKTOK_PUBLISHING_ENABLED=false
TIKTOK_CLIENT_KEY=REPLACE_ME
TIKTOK_CLIENT_SECRET=REPLACE_ME
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=REPLACE_ME
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_ENCRYPTION_KEY=REPLACE_ME
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_PUBLISH_MODE=direct
TIKTOK_MEDIA_DOMAIN=infenergy-intelligence-os.up.railway.app
